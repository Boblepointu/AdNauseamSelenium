# ============================================================================
# Example environment file for AdNauseam browser automation.
# Copy to `.env` (same directory as the compose file) and adjust:
#     cp .env.example .env
#
# `docker compose` and `docker stack deploy` both read `.env` from the current
# directory and interpolate ${VAR} references in the compose files.
#
# Every variable below has a sensible default baked into the compose files, so
# `.env` is optional -- override only what you need.
# ============================================================================

# ----------------------------------------------------------------------------
# Selenium hub connection (client side)
# ----------------------------------------------------------------------------
# host:port form only -- no scheme, no /wd/hub (the app appends those).
SELENIUM_HUB=selenium-hub:4444

# ----------------------------------------------------------------------------
# Swarm ingress hostname (docker-compose.swarm-optimized.yml, Traefik router)
# ----------------------------------------------------------------------------
# Public hostname Traefik routes the (authenticated) grid UI on.
# Was previously hardcoded to an internal host -- set to your own domain.
SELENIUM_HOST=selenium.local

# ----------------------------------------------------------------------------
# Swarm node placement (docker-compose.swarm-optimized.yml)
# ----------------------------------------------------------------------------
# Services are placed with the constraint: node.labels.role == ${BROWSER_NODE_ROLE}
# This REPLACES the old hardcoded `node.hostname == <host>` constraint so the
# stack is portable. Label the target worker node(s) ONCE before deploying:
#     docker node update --label-add role=browser <node-name>
BROWSER_NODE_ROLE=browser

# ----------------------------------------------------------------------------
# Replica counts (docker-compose.swarm-optimized.yml)
# ----------------------------------------------------------------------------
SELENIUM_HUB_REPLICAS=1        # keep at 1 (single hub / event bus)
NODE_REPLICAS=1                # replicas PER browser-node service (24 node services)
BROWSER_AUTOMATION_REPLICAS=2  # crawler client replicas

# ----------------------------------------------------------------------------
# Memory limits / reservations (docker-compose.swarm-optimized.yml)
# ----------------------------------------------------------------------------
# IMPORTANT: every service that sets a memory RESERVATION also sets a memory
# LIMIT. The sum of RESERVATIONS across all replicas placed on a node must NOT
# oversubscribe that node's RAM, or `docker stack deploy` will fail to schedule
# (or the kernel OOM-killer will start reaping containers). Do the math:
#   hub(1) + nodes(24 * NODE_REPLICAS) + automation(BROWSER_AUTOMATION_REPLICAS)
# For the defaults below the reservation total is ~2 + 24*0.768 + 2*0.384 ≈ 21GB,
# which fits a 24GB node. Raise NODE_REPLICAS only if you add RAM.
SELENIUM_HUB_MEM_LIMIT=3G
SELENIUM_HUB_MEM_RESERVATION=2G
NODE_MEM_LIMIT=1G
NODE_MEM_RESERVATION=768M
BROWSER_AUTOMATION_MEM_LIMIT=512M
BROWSER_AUTOMATION_MEM_RESERVATION=384M

# ----------------------------------------------------------------------------
# Persona rotation (docker-compose.production.yml crawler client)
# ----------------------------------------------------------------------------
PERSONA_ROTATION_STRATEGY=weighted   # weighted | random | round-robin
PERSONA_MAX_AGE_DAYS=30
PERSONA_MAX_USES=100

# ----------------------------------------------------------------------------
# Notes
# ----------------------------------------------------------------------------
# * Browser node services mount a 2GB tmpfs at /dev/shm (service-level shm_size
#   is IGNORED by `docker stack deploy`). This is not tunable via .env by design.
# * The Selenium grid is NOT published on host ports in the swarm/production
#   stacks; reach it over the internal overlay or the authenticated Traefik
#   router only.
